# Core
API_ADDR=:8080
DATABASE_URL=postgres://phishforge:devpass@localhost:5432/phishforge?sslmode=disable
REDIS_ADDR=localhost:6379

# Encryption (generate: openssl rand -hex 32)
ARTIFACT_ENC_KEY=

# LLM (M6) — empty LLM_BASE_URL disables /llm/generate (returns 503).
# Never assume localhost; point at the actual Ollama host, e.g.
# http://192.168.2.164:11434
LLM_BASE_URL=
LLM_MODEL=llama3.1:8b
# LLM_TIMEOUT accepts seconds (120) or a Go duration (90s, 2m). Default 120s.
LLM_TIMEOUT=120s

# Legacy OSINT/LLM host vars (unused by the API; kept for services/osint-py).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Delivery (fill when building M3)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
MSGRAPH_CLIENT_ID=
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_SECRET=

BASE_URL=http://localhost:8080

# Delivery worker
SEND_CONCURRENCY=10

# API delivery channel: Microsoft Graph (all optional; unset => SMTP-only).
# A graph sending-profile can override tenant/client/secret per profile.
LOGIN_BASE_URL=https://login.microsoftonline.com
GRAPH_BASE_URL=https://graph.microsoft.com
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Gmail API delivery channel (OAuth2 refresh-token flow; all optional). A
# gmail sending-profile's encrypted `secret` may supply the refresh token
# instead of GMAIL_REFRESH_TOKEN.
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GMAIL_BASE_URL=https://gmail.googleapis.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Bounce mailbox (IMAP). Optional; unset => no bounce polling. When set, the
# worker polls the mailbox, parsing NDRs into bounced events for the matched
# recipient (idempotent per message-id).
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_USE_TLS=true

ENGINE_DATA_DIR=data/engines